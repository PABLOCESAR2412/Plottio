---
const features = [
	{ icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>', title: "Kits Pre-configurados", desc: "Ej: Combo Logístico (2 placas + Logo + 15m Cinta)." },
	{ icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>', title: "Transferencias Seguras", desc: "Mueve insumos físicos entre sucursales." },
	{ icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 8 22 14 16 14"/><polyline points="2 10 2 4 8 4"/><path d="M2 14c4 4 10.5 4.5 15.5.5L22 10"/><path d="M22 10c-4-4-10.5-4.5-15.5-.5L2 14"/></svg>', title: "Alertas de Stock", desc: "Alertas automáticas de stock mínimo." }
];
---
<section class="py-24 px-6 bg-primary text-primary-foreground relative overflow-hidden">
	<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
		<div>
			<h2 class="kit-element opacity-0 translate-y-8 text-sm font-bold tracking-widest text-primary-foreground/70 uppercase mb-4">
				Estandarización Corporativa
			</h2>
			<h3 class="kit-element opacity-0 translate-y-8 text-3xl md:text-5xl font-bold mb-6 leading-tight">
				Kits de Flota & <br/>
				Inventario sin fugas.
			</h3>
			<p class="kit-element opacity-0 translate-y-8 text-lg text-primary-foreground/80 mb-8">
				Acelera tus ventas creando "Kits" (combos de servicios e insumos) para clientes corporativos recurrentes. Mantén el control estricto de materiales.
			</p>
			
			<ul class="space-y-6">
				{features.map((item) => (
					<li class="kit-element opacity-0 translate-y-8 flex gap-4 items-start">
						<div class="p-3 rounded-lg bg-primary-foreground/10 text-primary-foreground shrink-0" set:html={item.icon}>
						</div>
						<div>
							<h4 class="font-bold text-lg">{item.title}</h4>
							<p class="text-primary-foreground/70 text-sm mt-1">{item.desc}</p>
						</div>
					</li>
				))}
			</ul>
		</div>

		<div class="kit-element opacity-0 translate-y-8 relative h-[500px] bg-black/20 rounded-3xl border border-white/10 backdrop-blur-md p-8 flex flex-col gap-4">
			<div class="flex justify-between items-center mb-4">
				<span class="font-bold text-xl">Kit: Transporte</span>
				<span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold">LogisCorp</span>
			</div>
			
			<div class="bg-white/5 border border-white/10 p-4 rounded-xl flex items-center justify-between">
				<div class="flex items-center gap-3">
					<div class="w-10 h-10 rounded bg-white/10 flex items-center justify-center"></div>
					<div>
						<div class="font-semibold text-sm">Placa Lateral</div>
						<div class="text-xs text-primary-foreground/60">Cantidad: 2</div>
					</div>
				</div>
				<div class="font-bold">$45.00</div>
			</div>
			
			<div class="mt-auto pt-6 border-t border-white/10 flex justify-between items-center">
				<span class="text-primary-foreground/70">Total Estimado</span>
				<span class="text-2xl font-bold">$90.00</span>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	
	document.addEventListener('DOMContentLoaded', () => {
		gsap.registerPlugin(ScrollTrigger);
		
		gsap.to(".kit-element", {
			scrollTrigger: {
				trigger: ".kit-element",
				start: "top center+=100",
				toggleActions: "play none none reverse",
			},
			y: 0,
			opacity: 1,
			duration: 0.7,
			stagger: 0.15,
			ease: "power2.out",
		});
	});
</script>
