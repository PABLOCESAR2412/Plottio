---
---
<section class="hero-section relative min-h-[90vh] flex flex-col items-center justify-center pt-24 pb-16 overflow-hidden px-6">
	<div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/5 via-background to-background"></div>

	<div class="max-w-4xl mx-auto text-center space-y-8 flex flex-col items-center">
		<div class="hero-badge inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary text-secondary-foreground text-sm font-medium border border-border opacity-0 translate-y-4">
			<span class="relative flex h-2 w-2">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
				<span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
			</span>
			Plottio 2.0 ya disponible
		</div>

		<h1 class="text-5xl md:text-7xl font-bold tracking-tight text-foreground leading-[1.1]">
			<span class="hero-word inline-block opacity-0 translate-y-8">El ERP</span>
			<span class="hero-word inline-block opacity-0 translate-y-8">especializado</span>
			<span class="hero-word inline-block opacity-0 translate-y-8">en</span>
			<span class="hero-word inline-block opacity-0 translate-y-8">rotulación</span>
			<span class="hero-word inline-block opacity-0 translate-y-8 text-primary/80">&amp;</span>
			<br class="hidden md:block" />
			<span class="hero-word inline-block opacity-0 translate-y-8">control</span>
			<span class="hero-word inline-block opacity-0 translate-y-8">de</span>
			<span class="hero-word inline-block opacity-0 translate-y-8">flotas.</span>
		</h1>

		<p class="hero-desc text-lg md:text-xl text-muted-foreground max-w-2xl font-medium leading-relaxed opacity-0 translate-y-4">
			Deja de usar software genérico. Plottio centraliza tus cotizaciones especializadas, controla tus lotes de producción y administra el inventario de todas tus sucursales sin fugas.
		</p>

		<div class="hero-btns flex flex-col sm:flex-row items-center gap-4 pt-4 opacity-0 translate-y-4">
			<button class="group flex items-center justify-center gap-2 bg-primary text-primary-foreground px-8 py-4 rounded-xl font-semibold transition-all hover:scale-105 hover:shadow-xl hover:shadow-primary/20">
				Agendar Demo
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</button>
			<button class="flex items-center justify-center gap-2 bg-secondary text-secondary-foreground px-8 py-4 rounded-xl font-semibold transition-all hover:bg-secondary/80">
				Ver características
			</button>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	
	document.addEventListener('DOMContentLoaded', () => {
		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
		
		tl.to('.hero-badge', { y: 0, opacity: 1, duration: 0.6 })
		  .to('.hero-word', { y: 0, opacity: 1, duration: 0.8, stagger: 0.05 }, "-=0.3")
		  .to('.hero-desc', { y: 0, opacity: 1, duration: 0.6 }, "-=0.5")
		  .to('.hero-btns', { y: 0, opacity: 1, duration: 0.6 }, "-=0.4");
	});
</script>
